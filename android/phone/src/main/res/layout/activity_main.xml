<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TV Cast"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="6dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/text2"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTv"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Select TV"
            app:icon="@drawable/ic_tv"
            app:iconTint="@color/text" />

        <Button
            android:id="@+id/btnDisconnect"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Disconnect from TV"
            app:icon="@android:drawable/ic_menu_close_clear_cancel"
            app:iconTint="#FF6B6B" />

        <Button
            android:id="@+id/btnRemote"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Remote"
            app:icon="@drawable/ic_play"
            app:iconTint="@color/text" />

        <Button
            android:id="@+id/btnClear"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Clear history"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/text2" />
    </LinearLayout>

    <!-- Home: tiles; each opens its own page. -->
    <LinearLayout
        android:id="@+id/tiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/actVideos"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Videos"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@android:drawable/ic_media_play"
                app:iconGravity="top"
                app:iconPadding="8dp"
                app:iconSize="28dp" />            <com.google.android.material.button.MaterialButton
                android:id="@+id/actPictures"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Pictures"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@android:drawable/ic_menu_gallery"
                app:iconGravity="top"
                app:iconPadding="8dp"
                app:iconSize="28dp" />            <com.google.android.material.button.MaterialButton
                android:id="@+id/actRadio"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Radio"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@android:drawable/ic_lock_silent_mode_off"
                app:iconGravity="top"
                app:iconPadding="8dp"
                app:iconSize="28dp" />        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/actLink"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Play link"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@android:drawable/ic_menu_send"
                app:iconGravity="top"
                app:iconPadding="8dp"
                app:iconSize="28dp" />            <com.google.android.material.button.MaterialButton
                android:id="@+id/actShowOnTv"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Show on TV"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_tv"
                app:iconGravity="top"
                app:iconPadding="8dp"
                app:iconSize="28dp" />            <com.google.android.material.button.MaterialButton
                android:id="@+id/actRemote"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="Remote"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="top"
                app:iconPadding="8dp"
                app:iconSize="28dp" />        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/actVpn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="VPN"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@android:drawable/ic_lock_lock"
                app:iconGravity="top"
                app:iconPadding="8dp"
                app:iconSize="28dp" />            <com.google.android.material.button.MaterialButton
                android:id="@+id/actApks"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="APK files"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconGravity="top"
                app:iconPadding="8dp"
                app:iconSize="28dp" />            <com.google.android.material.button.MaterialButton
                android:id="@+id/actRecent"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="History"
                android:textSize="13sp"
                app:cornerRadius="18dp"
                app:icon="@android:drawable/ic_menu_recent_history"
                app:iconGravity="top"
                app:iconPadding="8dp"
                app:iconSize="28dp" />        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Continue watching"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSeeAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See all" />
        </LinearLayout>
    </LinearLayout>

    <!-- Page (Videos / Pictures / History): back arrow + title. -->
    <LinearLayout
        android:id="@+id/pageBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Back"
            app:icon="@drawable/abc_ic_ab_back_material"
            app:iconTint="@color/text" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="@color/accent"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/text"
        app:tabTextColor="@color/text2" />

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/search_bg"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:drawableTint="@color/text2"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text"
        android:textColorHint="@color/text2"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:id="@+id/chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSort"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:checkable="false"
                app:chipIcon="@android:drawable/ic_menu_sort_by_size"
                app:chipIconVisible="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFolder"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipShow"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                app:checkedIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReset"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:textColor="#FF6B6B" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/text2"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
