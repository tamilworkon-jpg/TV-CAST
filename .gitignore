# Build output
android/.gradle/
android/**/build/
android/local.properties
out/

# Signing key (generated locally by build.ps1)
android/keystore/
*.keystore
*.jks

# Local tools, test files and unrelated downloads
tools/
downloads/

# iOS build output (project is generated from ios/project.yml by XcodeGen)
ios/build/
ios/Payload/
ios/*.xcodeproj/
*.ipa

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
